# ==============================================================================
# NourishSync — Environment Configuration Example (.env.example)
# Copy this file to .env and provide your deployment secrets.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Database URL
# For local SQLite: sqlite:///./food_surplus.db
# For Docker / PostgreSQL: postgresql://postgres:postgres_secure_password_2026@db:5432/food_surplus_db
DATABASE_URL=sqlite:///./food_surplus.db

# JWT Security
JWT_SECRET=super_secret_devops_food_surplus_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ==============================================================================
# Email Delivery Service (Gmail SMTP Configuration)
# NourishSync sends verification & notification emails from: nourishsync@gmail.com
# To enable real Gmail delivery:
# 1. Enable 2-Step Verification on your Gmail account (nourishsync@gmail.com)
# 2. Generate an "App Password" under Google Account -> Security -> 2-Step Verification -> App Passwords
# 3. Enter the 16-character generated app password below.
# If credentials are left blank, NourishSync automatically logs emails to console in Dev Mode.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nourishsync@gmail.com
SMTP_APP_PASSWORD=your_16_character_gmail_app_password
EMAIL_FROM=nourishsync@gmail.com

# ==============================================================================
# First Administrator Initialization (Used by init_admin CLI or deployment)
# Passwords must be at least 10 chars with uppercase, lowercase, digit, & symbol.
# ==============================================================================
ADMIN_EMAIL=admin@nourishsync.org
ADMIN_PASSWORD=ChangeMeSecure2026!
